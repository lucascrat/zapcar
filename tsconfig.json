{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "types": [
      "node",
      "geojson"
    ],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "src/**/*",
    "components/**/*",
    "services/**/*",
    "utils/**/*",
    "types.ts",
    "constants.ts",
    "App.tsx",
    "index.tsx"
  ],
  "exclude": [
    "node_modules",
    "git",
    "supabase/functions",
    "dist",
    "android",
    "capacitor"
  ]
}