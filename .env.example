# Google Maps API key (Maps JavaScript, Geocoding, Directions, Places Text Search) - provedor principal
# Obtenha em https://console.cloud.google.com/google/maps-apis
VITE_GOOGLE_MAPS_API_KEY=

# Token público do Mapbox (pk.xxx) - usado como fallback se o Google Maps falhar ao carregar
# https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=

# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Gemini
GEMINI_API_KEY=
